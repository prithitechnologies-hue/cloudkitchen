{
  "firestore": { "rules": "firestore.rules" },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", "SETUP.txt", "_headers", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "**/*.@(html|js)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
