rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // CHANGE to the owner's login email (lowercase). Add more emails inside [ ] if needed.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email in ['owner@example.com'];
    }

    function validItem(d) {
      return d.keys().hasOnly(['cat','name','desc','price','veg','available','order'])
          && d.cat is string && d.cat.size() > 0 && d.cat.size() <= 30
          && d.name is string && d.name.size() > 0 && d.name.size() <= 80
          && d.desc is string && d.desc.size() <= 200
          && d.price is number && d.price >= 0 && d.price <= 10000
          && d.veg is bool
          && d.available is bool
          && d.order is number;
    }

    match /menu/{item} {
      allow read: if true;
      allow create, update: if isAdmin() && validItem(request.resource.data);
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
