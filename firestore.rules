rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ADMIN: paste the owner's Firebase User UID here (Authentication > Users tab,
    // or shown on /admin.html after the owner signs in). Add more UIDs inside [ ].
    function isAdmin() {
      return request.auth != null
          && request.auth.uid in ['kKAU3FthCVhz5Pf9HSr8m4RLHJh2'];
    }

    function validItem(d) {
      return d.keys().hasOnly(['cat','name','desc','price','veg','available','order','limit'])
          && d.cat is string && d.cat.size() > 0 && d.cat.size() <= 30
          && d.name is string && d.name.size() > 0 && d.name.size() <= 80
          && d.desc is string && d.desc.size() <= 200
          && d.price is number && d.price >= 0 && d.price <= 10000
          && d.veg is bool
          && d.available is bool
          && d.order is number
          && (!('limit' in d) || (d.limit is number && d.limit >= 1 && d.limit <= 500));
    }

    function validOrder(d) {
      return d.keys().hasOnly(['uid','orderNo','name','phone','block','flat','slot','items',
                               'subtotal','fee','total','pay','paid','utr','hasProof','note','status','slotDate','createdAt'])
          && d.uid == request.auth.uid
          && d.status == 'new'
          && d.paid == false
          && d.utr is string && d.utr.size() <= 22
          && d.hasProof is bool
          && d.slotDate is string && d.slotDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.createdAt == request.time
          && d.orderNo is string && d.orderNo.size() <= 12
          && d.name is string && d.name.size() > 0 && d.name.size() <= 60
          && d.phone is string && d.phone.matches('^[6-9][0-9]{9}$')
          && d.block is string && d.block.size() <= 40
          && d.flat is string && d.flat.size() > 0 && d.flat.size() <= 20
          && d.slot is string && d.slot.size() <= 80
          && d.items is list && d.items.size() > 0 && d.items.size() <= 30
          && d.subtotal is number && d.fee is number && d.total is number
          && d.total == d.subtotal + d.fee && d.total >= 0 && d.total <= 100000
          && d.pay in ['Cash on delivery', 'UPI']
          && d.note is string && d.note.size() <= 300;
    }

    function validProfile(d) {
      return d.keys().hasOnly(['name','phone','block','flat'])
          && d.name is string && d.name.size() <= 60
          && d.phone is string && d.phone.size() <= 10
          && d.block is string && d.block.size() <= 40
          && d.flat is string && d.flat.size() <= 20;
    }

    // Menu: anyone can read, only admin can change
    match /menu/{item} {
      allow read: if true;
      allow create, update: if isAdmin() && validItem(request.resource.data);
      allow delete: if isAdmin();
    }

    // Orders: signed-in customers create their own; they and the admin can read;
    // only admin can change the status / paid flag.
    match /orders/{orderId} {
      allow create: if request.auth != null && validOrder(request.resource.data);
      allow get, list: if request.auth != null
                       && (isAdmin() || resource.data.uid == request.auth.uid);
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','paid'])
                    && request.resource.data.status in ['new','confirmed','out','delivered','cancelled']
                    && request.resource.data.paid is bool;
      allow delete: if false;
    }

    // Daily stock counters (doc id = <delivery date>_<menu item id>).
    // Anyone can read (menu shows "Only N left"). A signed-in customer can only raise
    // the counter by up to 10, in the same batch as an order of their own (existsAfter/getAfter).
    function validStock(d) {
      return d.keys().hasOnly(['date','item','sold','lastOrder','lastUid'])
          && d.date is string && d.date.size() == 10
          && d.item is string && d.item.size() > 0 && d.item.size() <= 40
          && d.sold is number && d.sold >= 0 && d.sold <= 1000
          && d.lastOrder is string && d.lastOrder.size() > 0
          && d.lastUid is string;
    }
    function orderBelongsToCaller(d) {
      return existsAfter(/databases/$(database)/documents/orders/$(d.lastOrder))
          && getAfter(/databases/$(database)/documents/orders/$(d.lastOrder)).data.uid == request.auth.uid;
    }
    match /stock/{sid} {
      allow read: if true;
      allow create: if isAdmin()
                    || (request.auth != null
                        && validStock(request.resource.data)
                        && request.resource.data.lastUid == request.auth.uid
                        && request.resource.data.sold <= 10
                        && sid == request.resource.data.date + '_' + request.resource.data.item
                        && orderBelongsToCaller(request.resource.data));
      allow update: if isAdmin()
                    || (request.auth != null
                        && validStock(request.resource.data)
                        && request.resource.data.lastUid == request.auth.uid
                        && request.resource.data.date == resource.data.date
                        && request.resource.data.item == resource.data.item
                        && request.resource.data.sold > resource.data.sold
                        && request.resource.data.sold - resource.data.sold <= 10
                        && orderBelongsToCaller(request.resource.data));
      allow delete: if isAdmin();
    }

    // Payment screenshots (small JPEG data-URL, doc id = order id). Only the customer who
    // placed the order can create one, in the same batch as the order; only they and the admin can read it.
    function validProof(d) {
      return d.keys().hasOnly(['uid','orderNo','img','createdAt'])
          && d.uid == request.auth.uid
          && d.createdAt == request.time
          && d.orderNo is string && d.orderNo.size() <= 12
          && d.img is string && d.img.size() > 100 && d.img.size() <= 700000;
    }
    match /proofs/{pid} {
      allow create: if request.auth != null && validProof(request.resource.data)
                    && existsAfter(/databases/$(database)/documents/orders/$(pid))
                    && getAfter(/databases/$(database)/documents/orders/$(pid)).data.uid == request.auth.uid;
      allow get: if request.auth != null && (isAdmin() || resource.data.uid == request.auth.uid);
      allow list, update: if false;
      allow delete: if isAdmin();
    }

    // Customer profile (saved name / phone / block / flat): only that customer
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && validProfile(request.resource.data);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
